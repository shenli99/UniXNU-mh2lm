diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 1234567..abcdefg 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -459,6 +459,26 @@ LEXT(start_first_cpu)
 
 	// Unlock the core for debugging
 	msr		OSLAR_EL1, xzr
+	
+	// PROBE 1: RED - Entry into start_first_cpu
+	mov		x10, #0x835ff800			// Framebuffer base from bootargs
+	mov		x11, #0xFF0000FF			// RED (ARGB)
+	mov		x12, #(1080*2160*4)			// Full screen size
+1:	str		w11, [x10], #4
+	subs	x12, x12, #4
+	b.ne	1b
+	dsb		sy
+	
 	msr		DAIFSet, #(DAIFSC_ALL)				// Disable all interrupts
+	
+	// PROBE 2: ORANGE - Interrupts disabled
+	mov		x10, #0x835ff800
+	mov		x11, #0xFFA500FF			// ORANGE
+	mov		x12, #(1080*2160*4)
+1:	str		w11, [x10], #4
+	subs	x12, x12, #4
+	b.ne	1b
+	dsb		sy
 
 	mov		x20, x0
 	mov		x21, #0
@@ -467,6 +487,16 @@ LEXT(start_first_cpu)
 	adrp	x0, EXT(LowExceptionVectorBase)@page
 	add		x0, x0, EXT(LowExceptionVectorBase)@pageoff
 	MSR_VBAR_EL1_X0
+	
+	// PROBE 3: YELLOW - Exception vectors set
+	mov		x10, #0x835ff800
+	mov		x11, #0xFFFF00FF			// YELLOW
+	mov		x12, #(1080*2160*4)
+1:	str		w11, [x10], #4
+	subs	x12, x12, #4
+	b.ne	1b
+	dsb		sy
 
 
 	// Get the kernel memory parameters from the boot args
@@ -499,6 +529,16 @@ LEXT(start_first_cpu)
 	mov		sp, x0
 
 	// Set up interrupt stack pointer
+	
+	// PROBE 4: GREEN - Exception stack set up
+	mov		x10, #0x835ff800
+	mov		x11, #0x00FF00FF			// GREEN
+	mov		x12, #(1080*2160*4)
+1:	str		w11, [x10], #4
+	subs	x12, x12, #4
+	b.ne	1b
+	dsb		sy
+	
 	adrp	x0, EXT(intstack_top)@page			// Load top of irq stack
 	add		x0, x0, EXT(intstack_top)@pageoff
 	add		x0, x0, x22							// Convert to KVA
@@ -617,6 +657,16 @@ Lbuild_arm_kernel_block_mapping_done:
 	// We now have a V=P mapping and a KVA mapping of the mach header.  We can now
 	// drop to KVA for execution.
 	add		x0, x0, lr
+	
+	// PROBE 5: CYAN - Page tables built
+	mov		x10, #0x835ff800
+	mov		x11, #0x00FFFFFF			// CYAN
+	mov		x12, #(1080*2160*4)
+1:	str		w11, [x10], #4
+	subs	x12, x12, #4
+	b.ne	1b
+	dsb		sy
+	
 	br		x0
 
 /*
@@ -644,6 +694,16 @@ common_start:
 	ldr		x1, [x0, SR_RESTORE_TCR_EL1]
 	MSR_TCR_EL1_X1
 
+	// PROBE 6: BLUE - TCR configured
+	mov		x10, #0x835ff800
+	mov		x11, #0x0000FFFF			// BLUE
+	mov		x12, #(1080*2160*4)
+1:	str		w11, [x10], #4
+	subs	x12, x12, #4
+	b.ne	1b
+	dsb		sy
+	
 	/* Set up translation table base registers.
 	 *	TTBR0 - V=P table @ top of kernel
 	 *	TTBR1 - KVA table @ top of kernel + 1 page
@@ -742,6 +802,16 @@ common_start:
 	adrp	x0, EXT(ExceptionVectorsBase)@page		// Load exception vector table base address
 	add		x0, x0, EXT(ExceptionVectorsBase)@pageoff
 	MSR_VBAR_EL1_X0
+	
+	// PROBE 7: PURPLE - Final exception vectors set
+	mov		x10, #0x835ff800
+	mov		x11, #0x800080FF			// PURPLE
+	mov		x12, #(1080*2160*4)
+1:	str		w11, [x10], #4
+	subs	x12, x12, #4
+	b.ne	1b
+	dsb		sy
 
 	// Enable the MMU and caches.
 #if defined(KERNEL_INTEGRITY_KTRR) || defined(KERNEL_INTEGRITY_CTRR)
@@ -749,6 +819,16 @@ common_start:
 #endif
 	MSR_SCTLR_EL1_X0
 	isb		sy
+	
+	// PROBE 8: WHITE - MMU and caches enabled!
+	mov		x10, #0x835ff800
+	mov		x11, #0xFFFFFFFF			// WHITE
+	mov		x12, #(1080*2160*4)
+1:	str		w11, [x10], #4
+	subs	x12, x12, #4
+	b.ne	1b
+	dsb		sy
 
 #if __ARM_KERNEL_PROTECT__
 	/*
